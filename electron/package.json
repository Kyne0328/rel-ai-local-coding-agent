{
  "name": "rel-ai-mcp-launcher",
  "version": "0.21.3",
  "private": true,
  "description": "Desktop launcher and dashboard host for Rel.AI MCP.",
  "author": "Kyne Anthony",
  "main": "main.js",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.relai.mcp",
    "productName": "Rel.AI MCP",
    "electronUpdaterCompatibility": ">=2.16",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kyne0328",
        "repo": "rel-ai-mcp",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher-utils.js",
      "managed-ngrok.js",
      "ipc-handlers.js",
      "launcher-config.js",
      "resource-path.js",
      "window-size.js",
      "tool-sleep-blocker.js",
      "dashboard-window.js",
      "dashboard-window-bounds.js",
      "dashboard-preload.js",
      "desktop-tray.js",
      "desktop-status.js",
      "approval-token.js",
      "recovery-window.js",
      "window-security.js",
      "runtime-log-buffer.js",
      "diagnostic-files.js",
      "app-updater.js",
      "app-updater-events.js",
      "app-updater-state.js",
      "update-version.js",
      "ipc-security.js",
      "desktop-settings.js",
      "desktop-lifecycle.js",
      "renderer/**",
      "build/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.js",
          "**/*.css"
        ]
      },
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "../public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../vendor/ngrok",
        "to": "bin/ngrok",
        "filter": [
          "win32/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rel.AI MCP",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
