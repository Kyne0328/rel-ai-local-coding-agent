{
  "name": "rel-ai-mcp-launcher",
  "version": "0.19.0",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.relai.mcp",
    "productName": "Rel.AI MCP",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher-utils.js",
      "managed-ngrok.js",
      "ipc-handlers.js",
      "launcher-config.js",
      "resource-path.js",
      "window-size.js",
      "window-smoke.js",
      "tool-sleep-blocker.js",
      "installed-smoke.js",
      "renderer/**",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.js",
          "**/*.css"
        ]
      },
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "../public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../vendor/ngrok",
        "to": "bin/ngrok",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
