{
  "name": "rel-ai-mcp-launcher",
  "desktopName": "com.relai.mcp.desktop",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "Desktop launcher and dashboard host for Rel.AI MCP.",
  "homepage": "https://github.com/Kyne0328/rel-ai-mcp",
  "author": {
    "name": "Kyne",
    "email": "Kyne0328@users.noreply.github.com",
    "url": "https://github.com/Kyne0328"
  },
  "main": "main.js",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.relai.mcp",
    "productName": "Rel.AI MCP",
    "electronUpdaterCompatibility": ">=2.16",
    "afterPack": "build/after-pack.js",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kyne0328",
        "repo": "rel-ai-mcp",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "launcher-utils.js",
      "ngrok-token.js",
      "managed-ngrok.js",
      "ipc-handlers.js",
      "launcher-config.js",
      "resource-path.js",
      "window-size.js",
      "tool-sleep-blocker.js",
      "taskbar-completion-badge.js",
      "dashboard-window.js",
      "dashboard-window-bounds.js",
      "window-chrome.js",
      "startup-background.js",
      "desktop-tray.js",
      "desktop-status.js",
      "approval-token.js",
      "recovery-window.js",
      "window-security.js",
      "local-protocol.js",
      "runtime-log-buffer.js",
      "diagnostic-files.js",
      "app-updater.js",
      "app-updater-events.js",
      "app-updater-state.js",
      "update-version.js",
      "ipc-security.js",
      "desktop-settings.js",
      "desktop-notifications.js",
      "desktop-lifecycle.js",
      "shutdown-coordinator.js",
      "controller-runtime.js",
      "renderer/**",
      "build/icon.png",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "../public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "@modelcontextprotocol/core/**",
          "@modelcontextprotocol/node/**",
          "@modelcontextprotocol/server/**",
          "@opentelemetry/**",
          "@hono/node-server/**",
          "hono/**",
          "zod/**",
          "!**/*.map",
          "!@modelcontextprotocol/*/src/**",
          "!@opentelemetry/*/src/**",
          "!@hono/*/src/**",
          "!hono/src/**",
          "!zod/src/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/*.ts",
          "!**/*.cts",
          "!**/*.mts"
        ]
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../release-manifest.json",
        "to": "release-manifest.json"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../vendor/ngrok",
          "to": "bin/ngrok",
          "filter": [
            "manifest.json",
            "win32/**"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Local ChatGPT repository bridge",
      "description": "Rel.AI MCP connects ChatGPT to approved local development workspaces through a secured desktop-managed MCP service.",
      "vendor": "Kyne",
      "maintainer": "Kyne <Kyne0328@users.noreply.github.com>",
      "executableName": "rel-ai-mcp",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Rel.AI MCP",
          "Comment": "Connect ChatGPT to approved local development workspaces",
          "Categories": "Development;Utility;",
          "Keywords": "ChatGPT;MCP;development;repository;",
          "StartupWMClass": "com.relai.mcp",
          "Terminal": false,
          "Type": "Application"
        }
      },
      "extraResources": [
        {
          "from": "../vendor/ngrok",
          "to": "bin/ngrok",
          "filter": [
            "manifest.json",
            "linux/**"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Rel.AI-MCP-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Rel.AI-MCP-${version}-linux-x64.${ext}",
      "packageCategory": "devel",
      "priority": "optional"
    },
    "nsis": {
      "artifactName": "Rel.AI-MCP-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rel.AI MCP",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Rel.AI-MCP-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
