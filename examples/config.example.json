{
  "version": 6,
  "stateDir": "/Users/you/.rel-ai-mcp",
  "auditLogPath": "\\Users\\you\\.rel-ai-mcp\\audit.jsonl",
  "toolMode": "chatgpt_local_repo",
  "trustedLocalAgent": true,
  "trustedBudgetMultiplier": 2,
  "productUx": {
    "staleHours": 24,
    "cleanupOlderThanHours": 168,
    "enableStateExport": true
  },
  "release": {
    "minimumReadinessScore": 80,
    "requireHttpToken": true
  },
  "telemetry": {
    "enabled": false,
    "endpoint": "",
    "sampleRatio": 1
  },
  "processEnvironment": {
    "allow": []
  },
  "workspaces": {
    "myapp": {
      "path": "/absolute/path/to/myapp",
      "repoSlug": "",
      "context": {
        "snapshotMaxFiles": 3000,
        "includeRoots": [],
        "excludePaths": [
          ".git",
          "node_modules",
          "build",
          "dist",
          "coverage"
        ]
      },
      "validationRules": {}
    }
  }
}
