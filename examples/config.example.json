{
  "version": 2,
  "stateDir": "/Users/you/.rel-ai-mcp",
  "auditLogPath": "",
  "toolMode": "chatgpt_local_repo",
  "trustedLocalAgent": true,
  "maxOutputBytes": 2097152,
  "telemetry": {
    "enabled": false,
    "endpoint": "",
    "sampleRatio": 1
  },
  "processEnvironment": {
    "allow": []
  },
  "workspaces": {
    "myapp": {
      "path": "/absolute/path/to/myapp",
      "protectedBranches": ["main", "master"],
      "defaultBaseBranch": "main",
      "allowedRemotes": ["origin"],
      "context": {
        "snapshotMaxFiles": 3000,
        "includeRoots": [],
        "excludePaths": [".git", "node_modules", "build", "dist", "coverage"]
      },
      "testCommands": {},
      "commands": {}
    }
  },
  "productUx": {
    "staleHours": 24,
    "cleanupOlderThanHours": 168,
    "enableStateExport": true
  }
}
