{
  "name": "rel-ai-mcp",
  "version": "0.19.2",
  "description": "Local ChatGPT repo bridge: one reliable workflow for snapshot, read, write, verify, diff, and reset configured local workspaces.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "rel-ai-mcp": "bin/rel-ai-mcp.js",
    "relai-mcp-config": "bin/relai-mcp-config.js",
    "rel-ai-mcp-http": "bin/rel-ai-mcp-http.js",
    "rel-ai-mcp-doctor": "bin/relai-mcp-config.js",
    "rel-ai-mcp-launch": "bin/rel-ai-mcp-launch.js"
  },
  "scripts": {
    "start": "node bin/rel-ai-mcp.js",
    "start:http": "node bin/rel-ai-mcp-http.js",
    "check": "node test/check-js.mjs",
    "typecheck": "tsc -p tsconfig.boundaries.json",
    "init-config": "node bin/relai-mcp-config.js init",
    "workspace:add": "node bin/relai-mcp-config.js workspace add",
    "testcmd:add": "node bin/relai-mcp-config.js test-command add",
    "cmd:add": "node bin/relai-mcp-config.js command add",
    "test": "npm run test:all",
    "test:repo-health": "node test/repo-health.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:http": "node test/http-smoke.mjs",
    "install:unix": "sh scripts/install-unix.sh",
    "install:windows": "scripts\\install-windows.cmd",
    "oneclick": "node bin/rel-ai-mcp-launch.js",
    "launch": "node bin/rel-ai-mcp-launch.js",
    "connector:print": "node bin/rel-ai-mcp-launch.js --print-only --show-token",
    "release:bump": "node scripts/release-bump.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:finalize": "node scripts/release-finalize.mjs",
    "release": "node scripts/release-bump.mjs",
    "test:release": "node scripts/release-check.mjs && node test/release-workflow-smoke.mjs",
    "test:fast-task": "node test/workspace-fast-task-smoke.mjs",
    "test:tunnel": "node test/tunnel-manager-smoke.mjs",
    "test:oneclick": "node test/oneclick-args-smoke.mjs",
    "test:compat": "node test/chatgpt-local-compat-smoke.mjs",
    "test:public-workflow": "node test/workflow-smoke.mjs",
    "test:connector-wording": "node test/connector-wording-smoke.mjs",
    "test:regressions": "node test/regression-fixes-smoke.mjs",
    "electron:dev": "cd electron && npx electron .",
    "electron:build": "cd electron && npx electron-builder --win --dir",
    "electron:dist": "cd electron && npx electron-builder --win",
    "test:electron": "node test/electron-launcher-smoke.mjs",
    "test:installed": "node scripts/installed-app-smoke.mjs",
    "test:http-auth": "node test/http-auth-smoke.mjs",
    "test:oauth": "node test/oauth-smoke.mjs",
    "test:safety-paths": "node test/safety-paths.mjs",
    "test:dashboard-wording": "node test/dashboard-wording-smoke.mjs",
    "test:workflow-config": "node test/workflow-config-normalization.mjs",
    "test:patch-update": "node test/patch-update-smoke.mjs",
    "test:checks": "node test/command-checks-smoke.mjs",
    "test:git-workflow": "node test/git-workflow-smoke.mjs",
    "test:staged-write": "node test/staged-write-fallback-unit.mjs",
    "test:all": "npm run check && npm run typecheck && node scripts/release-check.mjs && node test/run-tests.mjs"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "coding-agent",
    "codex",
    "git",
    "pull-request"
  ],
  "author": {
    "name": "Kyne0328",
    "url": "https://github.com/Kyne0328"
  },
  "homepage": "https://github.com/Kyne0328/rel-ai-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kyne0328/rel-ai-mcp.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "7.0.2"
  }
}
