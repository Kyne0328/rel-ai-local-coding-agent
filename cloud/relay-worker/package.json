{
  "name": "@rel-ai/cloud-relay-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --test test/*.test.mjs && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:local-flow": "node test/local-flow.mjs",
    "db:migrate:local": "wrangler d1 migrations apply rel-ai-cloud --local",
    "db:migrate:remote": "wrangler d1 migrations apply rel-ai-cloud --remote"
  },
  "devDependencies": {
    "wrangler": "4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
